---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categoryOptions = games.reduce<{ id: number; name: string }[]>((options, game) => {
  if (game.category && !options.some((category) => category.id === game.category?.id)) {
    options.push(game.category);
  }
  return options;
}, []).sort((a, b) => a.name.localeCompare(b.name));
const publisherOptions = games.reduce<{ id: number; name: string }[]>((options, game) => {
  if (game.publisher && !options.some((publisher) => publisher.id === game.publisher?.id)) {
    options.push(game.publisher);
  }
  return options;
}, []).sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      {games.length > 0 && (
        <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" aria-label="Filter games" data-testid="game-filters">
          <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
            <fieldset>
              <legend class="mb-3 text-sm font-semibold text-slate-100">Categories</legend>
              <div class="flex flex-wrap gap-3">
                {categoryOptions.map((category) => (
                  <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 focus-within:ring-2 focus-within:ring-blue-500">
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      class="accent-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      data-testid="category-filter"
                    />
                    {category.name}
                  </label>
                ))}
              </div>
            </fieldset>

            <div class="flex flex-col gap-2">
              <label for="publisher-filter" class="text-sm font-semibold text-slate-100">Publisher</label>
              <select
                id="publisher-filter"
                name="publisher"
                class="min-w-52 rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publisherOptions.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>

            <button
              type="button"
              class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="clear-filters"
            >
              Clear filters
            </button>
          </div>
        </form>
      )}

      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>
      {games.length > 0 && (
        <p class="mb-4 text-sm text-slate-300" role="status" aria-live="polite" data-testid="filter-results">
          Showing {games.length} {games.length === 1 ? 'game' : 'games'}.
        </p>
      )}

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      {games.length > 0 && (
        <p class="mt-6 text-center text-slate-300" data-testid="filter-empty-state" hidden>
          No games match these filters.
        </p>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const categoryFilters = Array.from(
    document.querySelectorAll<HTMLInputElement>('[data-testid="category-filter"]'),
  );
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
  const clearFiltersButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');

  if (gameCards.length > 0) {
    if (!filterForm || !publisherFilter || !resultCount || !emptyState || !clearFiltersButton) {
      throw new Error('Game filter controls are missing from the catalog page.');
    }

    /**
     * Applies the current category and publisher selections to the rendered game cards.
     */
    const updateVisibleGames = (): void => {
      const selectedCategoryIds = new Set(
        categoryFilters.filter((filter) => filter.checked).map((filter) => filter.value),
      );
      const selectedPublisherId = publisherFilter.value;
      let visibleCount = 0;

      for (const card of gameCards) {
        const categoryId = card.dataset.gameCategoryId ?? '';
        const publisherId = card.dataset.gamePublisherId ?? '';
        const matchesCategory =
          selectedCategoryIds.size === 0 || selectedCategoryIds.has(categoryId);
        const matchesPublisher = selectedPublisherId === '' || publisherId === selectedPublisherId;
        const isVisible = matchesCategory && matchesPublisher;

        card.hidden = !isVisible;
        card.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount++;
      }

      resultCount.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}.`;
      emptyState.hidden = visibleCount > 0;
    };

    filterForm.addEventListener('change', updateVisibleGames);
    clearFiltersButton.addEventListener('click', () => {
      for (const filter of categoryFilters) filter.checked = false;
      publisherFilter.value = '';
      updateVisibleGames();
    });
  }
</script>
